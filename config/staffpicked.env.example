# StaffPicked settings shared by collections and playlists. Copy to staffpicked.env and fill in.
# Holds keys and user names, so staffpicked.env stays out of git.
# One KEY=value per line, no quotes. Lines starting with # are ignored.
#
# ============================================================================
# KEY: every setting, what it takes, and its default (blank = not set).
# Only the keys for the sources and images you use are needed; the "check"
# command says which are missing. Each one is explained again below.
# ============================================================================
#
# What to build
#   ENABLE_COLLECTIONS    true/false      build collections.toml (default true)
#   ENABLE_PLAYLISTS      true/false      build playlists.toml (default true)
#                                         (if neither is set, both are built)
#   ENABLE_GENRES         true/false      set the artwork in genres.toml (default true)
# Media server (server 1; more servers below)
#   SERVER_NAME           text            its name in StaffPicked; blank = its type ("Emby")
#   SERVER_TYPE           emby/jellyfin   default emby
#   SERVER_URL            http://host:port   e.g. http://192.168.1.10:8096 (not localhost
#                                         inside Docker; use the server's LAN address)
#   SERVER_API_KEY        text            an API key from the server's dashboard
#   SERVER_USER           name or ID      admin that owns shared playlists; blank = first admin
#   SERVER_PASSWORD       text            that user's password, only to share playlists
#                                         (and on Jellyfin, to reorder them)
# Playlist viewers
#   WATCHED_BY            a, b            users whose viewing drops films; blank = SERVER_USER
#   PLAYLIST_USERS        a, b            give each their own private playlists; blank = shared
#   LINKED_USERS          a, b; c, d      groups that share watched status (";" between groups)
# More media servers: the same settings numbered from 2, each server with its own
# users: SERVER_2_NAME, SERVER_2_TYPE, SERVER_2_URL, SERVER_2_API_KEY, SERVER_2_USER,
# SERVER_2_PASSWORD, SERVER_2_WATCHED_BY, SERVER_2_PLAYLIST_USERS, SERVER_2_LINKED_USERS,
# then SERVER_3_... Everything syncs to every server unless a list's servers = [...]
# picks some.
# List sources
#   MDBLIST_API_KEY       text            for mdblist sources
#   TRAKT_CLIENT_ID       text            for trakt sources
#   TRAKT_ACCESS_TOKEN    text            for private Trakt lists and watchlists
# Artwork sources
#   TMDB_API_TOKEN        text            for tmdb: images (the v4 Read Access Token)
#   FANARTTV_API_KEY      text            for fanart: images
#   MEDIUX_API_TOKEN      text            for mediux: images by movie, collection or set
# Schedule (Docker)
#   SYNC_TIME             HH:MM, HH:MM    24-hour sync times every day in TIME_ZONE (06:00)
#   SYNC_EVERY            6h / 90m / 1h30m   sync on an interval instead; blank = use
#                                         SYNC_TIME (at least 15m)
#   TIME_ZONE             Area/City       e.g. America/Chicago; blank = the container's TZ
#   SYNC_ON_START         true/false      also sync when the container starts (true)
# Notifications (Docker)
#   NOTIFY_URL            https://...     Discord/Slack webhook, Gotify, ntfy topic or any URL
#   NOTIFY_ON             failures/always after the startup and scheduled syncs (failures)
# Requests (optional; a list window's Request button sends one missing title)
#   REQUEST_SERVICE       seerr/arr       seerr = Seerr for films and TV (default);
#                                         arr = Radarr for films, Sonarr for TV
#   SEERR_URL             http://host:port   e.g. http://192.168.1.10:5055 (Overseerr
#                                         and Jellyseerr work too)
#   SEERR_API_KEY         text            Seerr > Settings > General > API Key
#   RADARR_URL            http://host:port   e.g. http://192.168.1.10:7878
#   RADARR_API_KEY        text            Radarr > Settings > General > API Key
#   RADARR_QUALITY_PROFILE  name          blank = Radarr's first profile
#   RADARR_ROOT_FOLDER    path            e.g. /movies; blank = Radarr's first root folder
#   RADARR_SEARCH         true/false      search for each film as it's added (true)
#   SONARR_URL            http://host:port   e.g. http://192.168.1.10:8989
#   SONARR_API_KEY        text            Sonarr > Settings > General > API Key
#   SONARR_QUALITY_PROFILE  name          blank = Sonarr's first profile
#   SONARR_ROOT_FOLDER    path            e.g. /tv; blank = Sonarr's first root folder
#   SONARR_SEARCH         true/false      search for each show's episodes as it's added (true)
# Options
#   REMOVAL_LIMIT         percent         hold back a sync that would take more than this
#                                         share of a list off the server; 0 = never (50)
#   NEW_FILM_CHECK        off/5m/15m/30m/1h  look for films just added to the server and sync
#                                         the lists missing them (15m; web UI only)
#   DRY_RUN               0/1             1 = preview only, change nothing (0)
# Reverse proxy (web UI; see Security > Reverse proxy in the user guide)
#   TRUSTED_PROXIES       ip, ip/range    proxies allowed to pass on the browser's address
#                                         and https (X-Forwarded-For/-Proto); blank = none
#   URL_BASE              /path           e.g. /staffpicked when the proxy serves it under
#                                         a path; blank = at the root
# ============================================================================

# --- What to build ---
ENABLE_COLLECTIONS=true
ENABLE_PLAYLISTS=true
ENABLE_GENRES=true

# --- Media server ---
# Its name in StaffPicked, which a list's servers = [...] setting uses. Blank = its
# type ("Emby" or "Jellyfin").
SERVER_NAME=
# emby or jellyfin
SERVER_TYPE=emby
SERVER_URL=http://YOUR_SERVER:8096
# Emby: Manage Emby Server > Advanced > API Keys. Jellyfin: Dashboard > API Keys.
SERVER_API_KEY=
# An admin user's name or ID. It owns the shared playlists. Blank = the first admin.
SERVER_USER=
# That user's password, used only to share playlists (Emby and Jellyfin only accept
# sharing from the owner signed in) and, on Jellyfin, to reorder them. Blank if it has none.
SERVER_PASSWORD=

# --- Playlist viewers ---
# Users (comma-separated names or IDs) whose viewing drops a film from shared
# playlists. Blank = only SERVER_USER. A playlist's own watched_by overrides it.
WATCHED_BY=
# Optional: give each of these users their own private copy of every playlist,
# hiding only what THEY watched. When set, SERVER_PASSWORD, WATCHED_BY and
# share are not used. Blank = one shared playlist owned by SERVER_USER.
PLAYLIST_USERS=
# Users who share watched status: one watching a film drops it for the others.
# Comma-separated; separate groups with ";" (a, b; c, d).
LINKED_USERS=

# --- More media servers (optional) ---
# Everything syncs to every server. Add a server with the same settings as above,
# numbered from 2, each with its own users (the web UI's Settings does this for you):
# SERVER_2_NAME=Living Room
# SERVER_2_TYPE=jellyfin
# SERVER_2_URL=http://192.168.1.20:8096
# SERVER_2_API_KEY=
# SERVER_2_USER=
# SERVER_2_PASSWORD=
# SERVER_2_WATCHED_BY=
# SERVER_2_PLAYLIST_USERS=
# SERVER_2_LINKED_USERS=

# --- List sources ---
# MDBList: bottom of https://mdblist.com/preferences/ under API Access.
# Your own private MDBList lists work with your key.
MDBLIST_API_KEY=
# Trakt: create an app at https://trakt.tv/oauth/applications and use its Client ID.
# Enough for public lists.
TRAKT_CLIENT_ID=
# Trakt private lists and watchlists also need an OAuth access token for the
# account that owns them.
TRAKT_ACCESS_TOKEN=

# --- Artwork sources (only needed for images that use them) ---
# TMDB: the "API Read Access Token" (v4) at https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
# fanart.tv: personal API key at https://fanart.tv/get-an-api-key/
FANARTTV_API_KEY=
# MediUX: your own API token from your MediUX account (an exact mediux:<asset id> needs none)
MEDIUX_API_TOKEN=
# ThePosterDB has no API for apps: download a poster from theposterdb.com yourself, then
# upload it in the web UI or save it in images/.

# --- Schedule (the Docker container's "schedule" mode) ---
# Sync every day at these times, 24-hour HH:MM in TIME_ZONE. One time or several,
# separated by commas: 06:00, 18:00. Edits to this folder are picked up at the
# next sync.
SYNC_TIME=06:00
# Or sync on an interval instead: 6h, 90m or 1h30m (at least 15m), counted from
# the last scheduled sync. When set, it replaces SYNC_TIME. Blank = use SYNC_TIME.
SYNC_EVERY=
# Your time zone, e.g. America/Chicago. It sets the sync time and which day it is
# for season windows. Blank = the container's TZ (docker-compose.yml).
TIME_ZONE=
# Also sync once when the container starts.
SYNC_ON_START=true

# --- Notifications ---
# Where to hear how the startup and scheduled syncs went: a Discord or Slack webhook,
# Gotify (https://gotify.example/message?token=...), an ntfy topic
# (https://ntfy.sh/your-topic), or any URL that takes a JSON post. Blank = none.
NOTIFY_URL=
# failures = only when a sync has a problem; always = after every sync.
NOTIFY_ON=failures

# --- Requests (optional) ---
# A list window marks each title the library doesn't have as Requested (the service
# has it but it hasn't downloaded yet), Available (downloaded; the next sync sees it)
# or Missing (nowhere yet), and its Request button sends just that one title.
# seerr = Seerr for films and TV; arr = Radarr for films and Sonarr for TV.
REQUEST_SERVICE=seerr

# Seerr (Overseerr and Jellyseerr work too). Requests go in as the admin, so they're
# approved straight away and Seerr passes them on to its Radarr and Sonarr.
SEERR_URL=
SEERR_API_KEY=

# Radarr, for films when REQUEST_SERVICE=arr.
RADARR_URL=
RADARR_API_KEY=
# A quality profile's name, and the root folder films go to (Settings lists Radarr's). Blank = Radarr's first.
RADARR_QUALITY_PROFILE=
RADARR_ROOT_FOLDER=
# Start searching for each film as soon as it's added.
RADARR_SEARCH=true

# Sonarr, for TV shows when REQUEST_SERVICE=arr.
SONARR_URL=
SONARR_API_KEY=
# A quality profile's name, and the root folder shows go to (Settings lists Sonarr's). Blank = Sonarr's first.
SONARR_QUALITY_PROFILE=
SONARR_ROOT_FOLDER=
# Start searching for each show's episodes as soon as it's added.
SONARR_SEARCH=true

# --- Options ---
# A sync that would take more than this percent of a list's films off the server
# (a list that came back empty, a library halfway through a rescan) changes nothing
# for that list and reports it instead. Sync Anyway in its list window lets it
# through. 0 = never hold back. Blank = 50.
REMOVAL_LIMIT=
# How often the web UI looks for films just added to the server. A list that was
# missing one syncs straight away. off, 5m, 15m, 30m or 1h. Blank = 15m.
NEW_FILM_CHECK=
# 1 = preview only, change nothing on the server.
DRY_RUN=0

# --- Reverse proxy (web UI) ---
# The IP addresses or ranges (comma-separated) of the reverse proxy in front of
# StaffPicked, e.g. 172.18.0.0/16 for a proxy on the same Docker network. Only requests
# from these may say which browser they're for and that it used https
# (X-Forwarded-For, X-Forwarded-Proto). Blank = trust no proxy.
TRUSTED_PROXIES=
# When the proxy serves StaffPicked under a path, like https://example.com/staffpicked,
# that path: /staffpicked. Blank = served at the root (https://staffpicked.example.com).
URL_BASE=
